# Generated from scripts/env-registry.mjs by scripts/generate-env-example.mjs. Do not edit by hand.
# Copy to .env.local for local development. Never commit real values.

# ---- Required ----
# Supabase project URL (ap-southeast-2) (public)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key; every client query is RLS-bound through the Clerk token (public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role access for admin APIs and the Stripe webhook; bypasses RLS (secret)
SUPABASE_SECRET_KEY=
# Clerk frontend key (pk_live_ in production) (public)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk Backend API: organisations, invitations, memberships (secret)
CLERK_SECRET_KEY=
# Verifies Clerk webhooks; the email.created event delivers the branded client invitation email (secret)
CLERK_WEBHOOK_SIGNING_SECRET=
# Must be /sign-in, or Clerk links fall back to the hosted Account Portal (public)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
# Must be /sign-up (invitation sign-up path) (public)
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
# Checkout Session creation and retrieval (sk_live_ in production) (secret)
STRIPE_SECRET_KEY=
# Verifies webhook signatures; the only path that marks an invoice PAID (secret)
STRIPE_WEBHOOK_SECRET=
# Invoice and contact email delivery (secret)
RESEND_API_KEY=
# Verified sender on a Resend-authenticated drylake.com.au subdomain (server)
EMAIL_FROM=
# Inbox that receives website and portal enquiries (server)
CONTACT_TO_EMAIL=
# HMAC key for customer appointment-management links (32+ random characters). Rotating it revokes every outstanding link (secret)
CONSULTATION_TOKEN_SECRET=
# Bearer secret for the consultation email dispatcher (Vercel Cron sends it automatically; pg_cron reads it from Supabase Vault) (secret)
CRON_SECRET=
# Turnstile widget site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-side Turnstile verification (secret)
TURNSTILE_SECRET_KEY=

# ---- Optional ----
# PEM public key for networkless session verification; optional (server)
CLERK_JWT_KEY=
# Optional sender for website enquiries; defaults to EMAIL_FROM's address as "Drylake website enquiries" (server)
CONTACT_EMAIL_FROM=
# "none" (default: Drylake bookings only, no Outlook events) or "microsoft" (Microsoft 365 free/busy, events, Teams links). Set to microsoft only after the MS_GRAPH_* app is scoped and tested (docs/operations/consultations.md) (server)
CONSULTATION_CALENDAR_PROVIDER=
# Drylake Microsoft 365 (Entra) tenant id; required when CONSULTATION_CALENDAR_PROVIDER=microsoft (server)
MS_GRAPH_TENANT_ID=
# App registration (client) id of the consultation calendar app; required when CONSULTATION_CALENDAR_PROVIDER=microsoft (server)
MS_GRAPH_CLIENT_ID=
# Client secret of the consultation calendar app (expires: put the expiry on the calendar); scoped by Exchange RBAC for Applications to the two consultation mailboxes only (secret)
MS_GRAPH_CLIENT_SECRET=
# Optional sender for consultation emails; defaults to EMAIL_FROM's address as "Drylake consultations" (server)
CONSULTATION_EMAIL_FROM=
# Extra hostnames accepted in Turnstile responses (server)
TURNSTILE_ALLOWED_HOSTNAMES=
# Canonical origin for emailed links; defaults to https://drylake.com.au. Leave unset in production (server)
APP_BASE_URL=
# Search Console HTML-tag token (public by design) (server)
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster HTML-tag token (public by design) (server)
BING_SITE_VERIFICATION=
# "true" turns the AI chat assistant on (launcher renders, /api/assistant answers). Default off: no launcher, API returns 404. Redeploy after changing (server)
CHAT_ASSISTANT_ENABLED=
# DERIVED at build from CHAT_ASSISTANT_ENABLED so the launcher is excluded from the bundle while the assistant is off. Never set by hand (server)
ASSISTANT_LAUNCHER_BUILD=
# disabled (default) | bedrock-sydney (Claude on Amazon Bedrock, ap-southeast-2) | mock (tests; refused when VERCEL_ENV=production) (server)
LLM_GATEWAY_PROVIDER=
# Bedrock model id. Must be anthropic.claude-* or au.anthropic.claude-* (Australia only); apac., global., us., eu. ids are refused. Default au.anthropic.claude-haiku-4-5-20251001-v1:0 (server)
ASSISTANT_MODEL_ID=
# HMAC key for chat session tokens (32+ random characters). Required when the assistant is enabled (secret)
ASSISTANT_SESSION_SECRET=
# Maximum assistant model calls per Perth day, per server instance (default 500). 0 closes the assistant (server)
ASSISTANT_DAILY_REQUEST_CAP=
# Maximum visitor messages per chat session (default 12) (server)
ASSISTANT_MAX_TURNS=
# Maximum assistant messages per IP address per 10 minutes, per instance (default 30) (server)
ASSISTANT_IP_LIMIT_10MIN=
# Maximum chat sessions started per IP address per 10 minutes, per instance (default 6) (server)
ASSISTANT_START_LIMIT_10MIN=
# Access key of the IAM user limited to bedrock:InvokeModel on the exact model ARNs (see the policy in the assistant runbook). Server only (secret)
AWS_ACCESS_KEY_ID=
# Secret for AWS_ACCESS_KEY_ID. Server only; never in the browser bundle (tested) (secret)
AWS_SECRET_ACCESS_KEY=
# Only when using temporary credentials (an assumed role). Not needed for a long-lived IAM user key (secret)
AWS_SESSION_TOKEN=
