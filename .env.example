# Generated from scripts/env-registry.mjs by scripts/generate-env-example.mjs. Do not edit by hand.
# Copy to .env.local for local development. Never commit real values.

# ---- Required ----
# Supabase project URL (ap-southeast-2) (public)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key; every client query is RLS-bound through the Clerk token (public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role access for admin APIs and the Stripe webhook; bypasses RLS (secret)
SUPABASE_SECRET_KEY=
# Clerk frontend key (pk_live_ in production) (public)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk Backend API: organisations, invitations, memberships (secret)
CLERK_SECRET_KEY=
# Verifies Clerk webhooks; the email.created event delivers the branded client invitation email (secret)
CLERK_WEBHOOK_SIGNING_SECRET=
# Must be /sign-in, or Clerk links fall back to the hosted Account Portal (public)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
# Must be /sign-up (invitation sign-up path) (public)
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
# Checkout Session creation and retrieval (sk_live_ in production) (secret)
STRIPE_SECRET_KEY=
# Verifies webhook signatures; the only path that marks an invoice PAID (secret)
STRIPE_WEBHOOK_SECRET=
# Invoice and contact email delivery (secret)
RESEND_API_KEY=
# Verified sender on a Resend-authenticated drylake.com.au subdomain (server)
EMAIL_FROM=
# Inbox that receives website and portal enquiries (server)
CONTACT_TO_EMAIL=
# Turnstile widget site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-side Turnstile verification (secret)
TURNSTILE_SECRET_KEY=

# ---- Optional ----
# PEM public key for networkless session verification; optional (server)
CLERK_JWT_KEY=
# Optional sender for website enquiries; defaults to EMAIL_FROM's address as "Drylake website enquiries" (server)
CONTACT_EMAIL_FROM=
# Extra hostnames accepted in Turnstile responses (server)
TURNSTILE_ALLOWED_HOSTNAMES=
# Canonical origin for emailed links; defaults to https://drylake.com.au. Leave unset in production (server)
APP_BASE_URL=
# Search Console HTML-tag token (public by design) (server)
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster HTML-tag token (public by design) (server)
BING_SITE_VERIFICATION=
